{
  "name": "exr-converter",
  "version": "1.0.3",
  "description": "Professional EXR sequence converter to editorial-ready video",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --dir",
    "build:fast": "tsc && vite build",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "package:mac": "node scripts/fetch-binaries.mjs && tsc && vite build && electron-builder --mac",
    "package:win": "node scripts/fetch-binaries.mjs && tsc && vite build && electron-builder --win --x64",
    "package:all": "node scripts/fetch-binaries.mjs && tsc && vite build && electron-builder -mw",
    "test:e2e": "tsx test/e2e-conversion.test.ts",
    "preview": "vite preview"
  },
  "keywords": [
    "exr",
    "openexr",
    "vfx",
    "converter",
    "ffmpeg",
    "video",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
